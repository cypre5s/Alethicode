{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TransferProblemCard",
  "type": "object",
  "required": [
    "title",
    "description"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "input_description": {
      "type": "string"
    },
    "output_description": {
      "type": "string"
    },
    "samples": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "input": {
            "type": "string"
          },
          "output": {
            "type": "string"
          }
        }
      }
    },
    "test_cases": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "hint": {
      "type": "string"
    },
    "reference_solution_language": {
      "type": "string"
    },
    "reference_solution_code": {
      "type": "string"
    },
    "target_kcs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "problem_id": {
      "type": "integer"
    },
    "problem_display_id": {
      "type": "string"
    },
    "temporary_problem": {
      "type": "boolean"
    },
    "visualize_intent": {
      "type": "string"
    },
    "visualize_prompt": {
      "type": "string"
    },
    "kc_error_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kc_id": {
            "type": "integer"
          },
          "kc_name": {
            "type": "string"
          },
          "error_count": {
            "type": "integer"
          }
        }
      }
    }
  },
  "additionalProperties": false
}