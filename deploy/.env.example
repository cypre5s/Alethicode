# === Local runtime defaults (safe for local competition deployment) ===
DB_PASSWORD=alethicode_db_local_2026
REDIS_PASSWORD=alethicode_redis_local_2026
JUDGE_SERVER_TOKEN=alethicode_judge_local_2026

# === Runtime paths inside containers ===
TEST_CASE_DIR=/test_case
UPLOAD_DIR=/data/public/upload
CLASSROOM_LESSON_DIR=/data/classroom_lessons
SUBMISSION_DATA_DIR=/data/submission
LANGUAGE_PACK_STORAGE_ROOT=/data/language_pack
LANGUAGE_PACK_PREVIEW_DIR=/data/language_pack/preview

# === AI provider (OpenAI-compatible) ===
# 默认：DeepSeek + 阿里云 DashScope embedding（国内合规最稳）
# 备选：通义千问 (dashscope.aliyuncs.com) / 字节火山 (ark.cn-beijing.volces.com)
#       / MiniMax (api.minimaxi.com) / 智谱 (open.bigmodel.cn)
# INIT_LLM_* 是"初始化 / 标准答案 / 代码质量要求高"的路由。
#
# OPENAI_API_KEY / INIT_LLM_API_KEY / EMBEDDING_API_KEY 必须在 backend/.env 中配置，
# 本文件不再保留空赋值。原因：deploy/.env 的空赋值在部分 docker compose 版本下会覆盖
# environment 段已从 shell env 替换好的真值，导致 alethicode-rag 调 LLM 一律 401。
# start.sh 在启动 alethicode-rag 前会校验这三个变量非空。
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
INIT_LLM_BASE_URL=https://api.deepseek.com
INIT_LLM_MODEL=deepseek-v4-flash
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4
LLM_API_TIMEOUT_SECONDS=150
LLM_API_MAX_RETRIES=9

# === Multi-provider failover (见 ADR-0002 + ADR-0006) ===
# 当 DeepSeek 挂时，按下面 profilePrefix 顺序尝试。可留空禁用。
# 例："INIT_LLM_,QWEN_LLM_,VOLCANO_LLM_"
ALETHICODE_AI_FALLBACK_PREFIXES=INIT_LLM_

# === Alethicode RAG microservice (LightRAG) ===
# alethicode-rag 暴露 8200 端口，Java 后端通过 RAG_SERVICE_URL 调用，
# Memgraph (bolt://memgraph:7687) 承担图谱存储；KV / Vector / DocStatus
# 仍走 PostgreSQL（pgvector）。所有内部调用必须带 X-Internal-Token。
RAG_SERVICE_URL=http://alethicode-rag:8200
RAG_INTERNAL_TOKEN=dev-internal-key
MEMGRAPH_WORKSPACE=alethicode
POSTGRES_VECTOR_INDEX_TYPE=HNSW_HALFVEC
POSTGRES_HNSW_M=16
POSTGRES_HNSW_EF=200
# 智谱 embedding-3 是 2048 维；pgvector 普通 HNSW 上限 2000 维，
# 必须用 HNSW_HALFVEC（halfvec 列，上限 4000 维）。
EMBEDDING_DIM=2048
ALETHICODE_RAG_MEMORY_LIMIT=768m
MEMGRAPH_MEMORY_LIMIT=512m

# 注意：项目生产实际使用智谱 embedding-3（2048 维）。
# .env.example 上面 DashScope text-embedding-v4 的默认值仅用于本地脱敏演示，
# 真正部署时请用 backend/.env 中的智谱端点。

# === Observability ===
# 默认关闭 OpenTelemetry tracing（ECS 无 Jaeger）。启用时需同时设 OTEL 端点：
#   MANAGEMENT_TRACING_ENABLED=true
#   OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318/v1/traces
MANAGEMENT_TRACING_ENABLED=false

# === alethicode-rag 代理 ===
# WSL 开发：RAG_HTTP_PROXY=http://127.0.0.1:7892
# ECS 生产：不设（默认空，直连公网）
#RAG_HTTP_PROXY=

# === Optional video generation ===
VIDEO_TTS_PROVIDER=stub
VIDEO_RENDER_PROVIDER=stub

# === Container resource limits (2C2G low-spec defaults) ===
POSTGRES_MEMORY_LIMIT=192m
REDIS_MEMORY_LIMIT=48m
BACKEND_MEMORY_LIMIT=900m
PROMETHEUS_MEMORY_LIMIT=64m
GRAFANA_MEMORY_LIMIT=96m
JUDGE_MEMORY_LIMIT=256m
FRONTEND_MEMORY_LIMIT=32m
JAVA_OPTS=-Xms128m -Xmx512m -XX:+UseSerialGC -XX:MaxMetaspaceSize=256m -XX:ReservedCodeCacheSize=96m -XX:+UseCompressedOops

# === GlitchTip 错误追踪（self-hosted，ADR-0004 合规） ===
# - 关闭：GLITCHTIP_PROFILE=disabled（profile 不匹配，4 个容器都不启动）
# - 启用：保留默认 GLITCHTIP_PROFILE=glitchtip
# 资源占用合计约 670MB（postgres 192 + redis 32 + web 256 + worker 192）
GLITCHTIP_PROFILE=glitchtip
GLITCHTIP_DB_PASSWORD=glitchtip_local_2026
GLITCHTIP_SECRET_KEY=please_change_in_prod_minimum_50_chars_random_alphanumeric
GLITCHTIP_DOMAIN=http://localhost:18000
GLITCHTIP_FROM_EMAIL=noreply@localhost
GLITCHTIP_BIND=127.0.0.1
GLITCHTIP_HOST_PORT=18000
GLITCHTIP_PG_MEMORY_LIMIT=192m
GLITCHTIP_REDIS_MEMORY_LIMIT=32m
GLITCHTIP_WEB_MEMORY_LIMIT=256m
GLITCHTIP_WORKER_MEMORY_LIMIT=192m

# === Sentry SDK（backend/frontend 共享） ===
# DSN 在 GlitchTip 启动后从 web UI 创建项目获得，再回填到这里。
# 默认空 → SDK no-op，主链路零影响
SENTRY_DSN=
SENTRY_ENVIRONMENT=prod
SENTRY_TRACES_SAMPLE_RATE=0.0
APP_VERSION=
# frontend 构建注入（vite 通过 VITE_SENTRY_DSN 暴露给浏览器）
VITE_SENTRY_DSN=
VITE_SENTRY_SAMPLE_RATE=1.0
VITE_SENTRY_TRACES_SAMPLE_RATE=0.0
