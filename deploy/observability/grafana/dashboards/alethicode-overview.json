              },
              {
                "color": "red",
                "value": 0.85
              }
            ]
          },
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "orientation": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "alethicode-prometheus"
          },
          "expr": "process_cpu_usage{application=\"alethicode-java\"}",
          "legendFormat": "cpu"
        }
      ]
    }
  ],
